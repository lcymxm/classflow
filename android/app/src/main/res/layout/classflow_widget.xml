<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/classflow_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="课序 · 今日"
            android:textColor="#1d2b27"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="11月12日 周四"
            android:textColor="#c5634b"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="3dp"
        android:maxLines="5"
        android:text="08:00  高等数学 A（上） · 教一 401&#10;10:00  大学英语 III · 外语楼 302"
        android:textColor="#1d2b27"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:text="我的课表 · 第 10 周 · 打开课序查看完整课表"
        android:textColor="#7b857d"
        android:textSize="8.5sp" />
</LinearLayout>
