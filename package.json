{
  "name": "classflow",
  "private": true,
  "version": "1.7.0",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "description": "课序 · 本地优先的大学课表。多课表、按日期切换作息、dsh-pet 鲸鱼娘桌宠、周次滑动、同课/同老师合并、节假日与 Android 小组件。",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "homepage": "https://lcymxm.github.io/classflow/",
  "repository": {
    "type": "git",
    "url": "https://github.com/lcymxm/classflow.git"
